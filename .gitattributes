#######################################
# Core text normalization
#######################################
# Normalize all text files to LF in repo, convert to native on checkout
* text=auto eol=lf

# C# source
*.cs text diff=csharp
*.cginc text
*.compute text
*.shader text
*.uss text
*.asmdef text
*.json text
*.xml text
*.yaml text
*.yml text
*.meta text

# Unity scenes & prefabs (YAML-based)
*.unity text
*.prefab text

#######################################
# Prevent Git from attempting text diffs on binary assets
#######################################
# Unity binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.tga binary
*.dds binary
*.psd binary
*.exr binary
*.tiff binary
*.fbx binary
*.anim binary
*.controller binary
*.mat binary

# Audio
*.wav binary
*.mp3 binary
*.ogg binary

# Videos
*.mp4 binary
*.mov binary

# Fonts
*.ttf binary
*.otf binary

#######################################
# LFS (Optional)
#######################################
# If your repo uses Git LFS, uncomment these to avoid giant repos.
# Note: Only enable if really needed — do not enable by accident.
#
# *.psd filter=lfs diff=lfs merge=lfs -text
# *.fbx filter=lfs diff=lfs merge=lfs -text
# *.png filter=lfs diff=lfs merge=lfs -text
# *.jpg filter=lfs diff=lfs merge=lfs -text
# *.wav filter=lfs diff=lfs merge=lfs -text

#######################################
# Special formats
#######################################
# Ignore line ending normalization for Windows-specific files
*.bat text eol=crlf
*.cmd text eol=crlf

# Prevent accidental diff on binary packaged files
*.unitypackage binary
*.zip binary
*.dll binary
*.exe binary

#######################################
# Documentation
#######################################
*.md text
*.txt text diff=markdown
